extends ./base

block vars
	- const user = category.user;
	- const title = privateMode ? instanceName : `絵文字カテゴリ : ${category.title}`;
	- const url = `${config.url}/@${user.username}/categories/${category.id}`;

block title
	= `${title} | ${instanceName}`

block desc
	unless privateMode
		meta(name='description' content= summary)

block og
	unless privateMode
		meta(property='og:type'        content='article')
		meta(property='og:title'       content= title)
		meta(property='og:description' content= summary)
		meta(property='og:url'         content= url)
		meta(property='og:image'       content= category.eyeCatchingImage ? category.eyeCatchingImage.thumbnailUrl : avatarUrl)
		if category.eyeCatchingImage
			meta(property='twitter:card' content='summary_large_image')
			meta(property='note:card' content='summary_large_image')

block meta
	unless privateMode
		-
			const robotsParts = [];
			if (profile.noCrawle) robotsParts.push('noindex');
			if (profile.preventAiLearning) { robotsParts.push('noai'); robotsParts.push('noimageai'); }
			if (category.eyeCatchingImage) robotsParts.push('max-image-preview:large');
		if robotsParts.length
			meta(name='robots' content=robotsParts.join(', '))

		meta(name='misskey:user-username' content=user.username)
		meta(name='misskey:user-id' content=user.id)
		meta(name='misskey:category-id' content=category.id)

		// todo
		if user.twitter
			meta(name='twitter:creator' content=`@${user.twitter.screenName}`)
