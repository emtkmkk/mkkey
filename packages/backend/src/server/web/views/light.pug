doctype html
html(lang="ja")
	head
		meta(charset="utf-8")
		meta(name="viewport" content="width=device-width, initial-scale=1.0")
		meta(name="application-name" content="mkkey")
		title Light Client - mkkey
		link(rel="stylesheet" href=`/light/light.css?v=${version}`)
		//- 描画前にテーマを適用してちらつきを防ぐ（設定は localStorage の light:settings:theme）
		script.
			try {
				var t = localStorage.getItem("light:settings:theme");
				document.documentElement.setAttribute("data-theme", t ? JSON.parse(t) : "system");
			} catch (e) {
				document.documentElement.setAttribute("data-theme", "system");
			}
	body
		div#app
			header#header
				h1#title Light Client
				div#header-main
					span#account-name
					button#header-streaming-btn(style="display:none" title="ストリーミング" aria-label="ストリーミング切り替え") ⚡
					button#header-reload-btn(style="display:none" title="再読込" aria-label="タイムラインを再読込") ↻
					button#header-menu-btn(style="display:none" title="メニュー" aria-label="メニュー" aria-haspopup="true") ⋮
					button#login-btn(style="display:none") ログイン
					button#header-guest-reload-btn(style="display:none" title="TL再読込" aria-label="タイムラインを再読込") ↻
					div#header-menu(style="display:none")
						button.header-menu-item(data-action="search") 検索
						button.header-menu-item(data-action="settings") 設定
						button.header-menu-item(data-action="back-to-normal") 通常版へ戻る
						button.header-menu-item(data-action="switch-account") アカウント切り替え
						button.header-menu-item(data-action="logout") ログアウト
			div#settings-panel(style="display:none")
				div.settings-section
					label テーマ
					select#setting-theme
						option(value="system") 端末に合わせる
						option(value="dark") ダーク
						option(value="light") ライト
				div.settings-section
					label アイコン表示
					input#setting-show-icons(type="checkbox" checked)
				div.settings-section
					label 通知を常時ストリーミング
					input#setting-notifications(type="checkbox")
				div.settings-section
					label 前回の公開範囲を記録する（TL毎）
					input#setting-remember-visibility(type="checkbox" checked)
				div.settings-section#default-visibility-section(style="display:none")
					label デフォルト公開範囲
					select#setting-default-visibility
						option(value="public") 公開
						option(value="home") ホーム
						option(value="followers") フォロワーのみ
				div.settings-section#default-local-section(style="display:none")
					label デフォルト mkkeyPublic
					input#setting-default-local-only(type="checkbox")
				div.settings-section
					label ワードミュート（改行区切り）
					textarea#setting-word-mute(rows="3" placeholder="キーワード1\nキーワード2")
				div.settings-section
					label よく使う絵文字
					div.settings-buttons
						button#setting-fetch-emojis.settings-btn 再取得
					div.settings-buttons
						button#settings-reload.settings-btn リロード
						button#settings-close.settings-btn 閉じる
			div#tabs
				button.tab-btn#tab-notifications(data-tl="notifications") 通知
				button.tab-btn(data-tl="home") ホーム
				button.tab-btn(data-tl="local") ローカル
				button.tab-btn(data-tl="global") グローバル
				button.tab-btn(data-tl="social") ソーシャル
				button.tab-btn(data-tl="recommended") おすすめ
				button.tab-btn(data-tl="antenna") アンテナ
				button.tab-btn(data-tl="list") リスト
				button.tab-btn(data-tl="channel") チャンネル
			div#tl-selector(style="display:none")
				label#tl-selector-label
				select#tl-selector-select
			div#post-form
				div#post-attributes
				div#post-form-main
					textarea#post-text(placeholder="何を考えていますか？")
					div#post-cw-area(style="display:none")
						label CW
						input#post-cw(placeholder="Content Warning")
					div#post-options
						button#post-cw-toggle(type="button") CW
						button#post-emoji-btn 絵文字
						select#post-visibility
							option(value="public") 公開
							option(value="home") ホーム
							option(value="followers") フォロワーのみ
							option(value="specified") DM
						label.post-options-mkkey
							input#post-local-only(type="checkbox")
							| mkkeyPublic
					div#post-emoji-picker(style="display:none")
					div#post-submit-row
						span#post-char-count.post-char-count
						button#post-submit 投稿
			div#error-banner(style="display:none")
				span#error-message
				button#error-retry リトライ
			div#notes-container
				div#notes
				button#load-more(style="display:none") もっと読む
			div#streaming-notifications(role="status" aria-live="polite")
			div#modal-overlay(style="display:none")
				div#modal-content
					div#modal-body
		script(src=`/light/light.js?v=${version}`)
