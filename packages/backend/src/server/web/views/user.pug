extends ./base

block vars
	//- カスタム絵文字の :shortcode: はテキストとして解釈されないので取り除く。
	//- 取り除いた結果が空になる（表示名が絵文字だけだった）場合は username へフォールバックする。
	- const displayName = user.name ? stripEmojiShortcodes(user.name).trim() : "";
	- const title = privateMode ? instanceName : (displayName ? `${displayName} (@${user.username})` : `@${user.username}`);
	- const url = `${config.url}/@${(user.host ? `${user.username}@${user.host}` : user.username)}`;

block title
	= `${title} | ${instanceName}`

block desc
	unless privateMode
		//- 生の改行を含めると、行単位で解析するクローラが以降のタグを取りこぼす
		meta(name='description' content= oneLine(profile.description))

block og
	unless privateMode
		//- 'blog' は OpenGraph に存在しない型。ユーザーページの正しい型は 'profile'
		meta(property='og:type'        content='profile')
		meta(property='profile:username' content= user.username)
		meta(property='og:title'       content= title)
		meta(property='og:description' content= oneLine(profile.description))
		meta(property='og:url'         content= url)
		meta(property='og:image'       content= ogImageUrl || avatarUrl)
		if ogImageUrl
			meta(property='og:image:width'  content='1200')
			meta(property='og:image:height' content='630')
			meta(property='og:image:type'   content='image/png')
		//- twitter:* は仕様上 name 属性で読まれる。base.pug が出しているのは property なので、
		//- 仕様に忠実なクローラ（Discord や OGP チェッカー）からは未設定に見えてしまう。
		//- base.pug 側を name へ変えると、property の自前タグを出している他のビューと
		//- 食い違って Twitter のサムネイルが消えるため、ここだけで name の分を補う。
		//- 値は base の twitterCard と同じなので、両方読まれても矛盾しない。
		meta(name='twitter:card'       content='summary_large_image')
		//- summary_large_image は twitter:image を参照するカード。og:image しか無いと
		//- 大きい画像を見つけられないクローラがある（GitHub も併記している）。
		meta(name='twitter:image'      content= ogImageUrl || avatarUrl)
		meta(property='note:card'      content='summary_large_image')

block meta
	unless privateMode
		-
			const robotsParts = [];
			if (user.host || profile.noCrawle) robotsParts.push('noindex');
			if (profile.preventAiLearning) { robotsParts.push('noai'); robotsParts.push('noimageai'); }
			robotsParts.push('max-image-preview:large');
		meta(name='robots' content=robotsParts.join(', '))

		meta(name='misskey:user-username' content=user.username)
		meta(name='misskey:user-id' content=user.id)

		if profile.twitter
			meta(name='twitter:creator' content=`@${profile.twitter.screenName}`)

		if !sub
			if !user.host
				link(rel='alternate' href=`${config.url}/users/${user.id}` type='application/activity+json')
			if user.uri
				link(rel='alternate' href=user.uri type='application/activity+json')
			if profile.url
				link(rel='alternate' href=profile.url type='text/html')

		each m in me
			link(rel='me' href=`${m}`)
